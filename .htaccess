<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Hide .php extension: Redirect external requests ending in .php to extensionless URLs
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/([^.]+)\.php[\s?] [NC]
    RewriteRule ^ %1 [R=301,L]

    # 2. If a physical directory exists, do not rewrite (allows /admin/ or /api/ to work)
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 3. Internally rewrite extensionless requests to the .php file if it exists
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*?)/?$ $1.php [L]
</IfModule>
